<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.pingoose" path="/org/gnome/shell/extensions/pingoose/">
    <key name="deleted-calendar-events" type="as"><default>[]</default><summary>Individually deleted calendar event identifiers</summary></key>
    <key name="agenda-calendar-scope" type="s"><choices><choice value="registered"/><choice value="all"/></choices><default>'registered'</default><summary>Agendas to sync</summary></key>
    <key name="start-reminders-sent" type="as"><default>[]</default><summary>Delivered start reminders</summary></key>
    <key name="notify-evaluation-reminder-enabled" type="b"><default>true</default><summary>Start reminders</summary></key>
    <key name="notify-evaluation-immediate" type="b"><default>true</default><summary>Immediate notifications</summary></key>
    <key name="evaluation-reminder-minutes" type="i"><range min="0" max="15"/><default>5</default><summary>Minutes before start</summary></key>
    <key name="notify-agenda-reminder-enabled" type="b"><default>true</default><summary>Start reminders</summary></key>
    <key name="notify-agenda-immediate" type="b"><default>true</default><summary>Immediate notifications</summary></key>
    <key name="agenda-reminder-minutes" type="i"><range min="0" max="10080"/><default>30</default><summary>Minutes before start</summary></key>
    <key name="sync-agenda-calendar" type="b"><default>false</default><summary>Sync agenda to the local desktop calendar</summary></key>
    <key name="auto-delete-past-agenda-calendar" type="b"><default>false</default><summary>Automatically delete ended agenda calendar events during sync</summary></key>
    <key name="agenda-calendar-status" type="s"><default>''</default><summary>Calendar sync status</summary></key>
    <key name="logtime-seconds-mode" type="s"><choices><choice value="truncate"/><choice value="sum"/></choices><default>'truncate'</default><summary>Truncate daily seconds or include them in the monthly total</summary></key>
    <key name="logtime-daily-limit" type="s"><choices><choice value="12h"/><choice value="all"/></choices><default>'12h'</default><summary>Daily logtime limit</summary></key>
    <key name="panel-shortcut" type="as"><default>[]</default><summary>Global shortcut to open Pingoose</summary></key>
    <key name="dismissed-agenda-ids" type="as"><default>[]</default><summary>Agenda cards acknowledged by the user</summary></key>
    <key name="agenda-reset-request" type="s"><default>''</default><summary>Restore dismissed agenda cards</summary></key>
    <key name="reset-request" type="s"><default>''</default><summary>Pending full reset request</summary></key>
    <key name="reset-status" type="s"><default>''</default><summary>Full reset progress</summary></key>
    <key name="hidden-cluster-chat" type="b"><default>false</default><summary>Allow general cluster chat</summary></key>
    <key name="hidden-auto-slots" type="b"><default>false</default><summary>Allow automatic slot creation</summary></key>
    <key name="dev-evaluation-offset-minutes" type="i"><range min="-10080" max="10080"/><default>-1</default><summary>Test evaluation start offset in minutes (negative: past, positive: future)</summary></key>
    <key name="dev-evaluation-role" type="s"><choices><choice value="evaluator"/><choice value="evaluated"/></choices><default>'evaluated'</default><summary>Test evaluation role</summary></key>
    <key name="auto-slot-duration-units" type="i"><range min="1" max="16"/><default>2</default><summary>Slot length in 15 minute units</summary></key>
    <key name="auto-slot-interval-units" type="i"><range min="1" max="96"/><default>4</default><summary>Gap after each slot ends in 15 minute units</summary></key>
    <key name="auto-slot-count" type="i"><range min="1" max="20"/><default>5</default><summary>Number of slots to create</summary></key>
    <key name="logout-request" type="s"><default>''</default><summary>Confirmed logout request</summary></key>
    <key name="hidden-options-unlocked" type="b"><default>false</default><summary>Hidden Options unlocked on this computer</summary></key>
    <key name="hidden-dev-options" type="b"><default>false</default><summary>Show developer actions</summary></key>
    <key name="panel-animations" type="b"><default>true</default><summary>Animate panels and sections</summary></key>
    <key name="panel-animation-duration" type="i"><range min="100" max="500"/><default>200</default><summary>Panel transition duration in milliseconds</summary></key>
    <key name="topbar-animation" type="b"><default>true</default><summary>Animate the Pingoose top bar icon</summary></key>
    <key name="expand-services" type="b"><default>false</default><summary>Expand services panel</summary></key>
    <key name="expand-chat" type="b"><default>false</default><summary>Expand chat panel</summary></key>
    <key name="expand-slots" type="b"><default>false</default><summary>Expand evaluation slots</summary></key>
    <key name="expand-evaluations" type="b"><default>true</default><summary>Expand evaluation info</summary></key>
    <key name="expand-agenda" type="b"><default>true</default><summary>Expand agenda</summary></key>
    <key name="expand-notifications" type="b"><default>true</default><summary>Expand notifications</summary></key>
    <key name="update-check-request" type="s"><default>''</default><summary>Request an immediate update check</summary></key>
    <key name="auto-update" type="b"><default>true</default><summary>Install available updates without prompting</summary></key>
    <key name="auto-close-panels" type="b"><default>false</default><summary>Close side panels when the main menu closes</summary></key>
    <key name="theme" type="s">
      <choices><choice value="dark"/><choice value="light"/></choices>
      <default>'dark'</default>
      <summary>Profile menu color theme</summary>
    </key>
    <key name="auto-hide-scrollbars" type="b"><default>true</default><summary>Hide panel scrollbars when scrolling stops</summary></key>
    <key name="chat-favorites-available-only" type="b"><default>false</default><summary>Show only available favorites</summary></key>
    <key name="chat-favorites" type="s"><default>'[]'</default><summary>Saved Cluster Chat favorite profiles</summary></key>
    <key name="notification-duration" type="i">
      <range min="0" max="120"/>
      <default>4</default>
      <summary>System notification banner duration in seconds</summary>
      <description>Zero keeps Pingoose banners visible until dismissed.</description>
    </key>
    <key name="flash-interval" type="d"><range min="0.5" max="10.0"/><default>1.0</default><summary>Seconds between screen flash pulse starts</summary></key>
    <key name="flash-preview-request" type="s"><default>''</default><summary>Request a screen flash preview</summary></key>
    <key name="flash-brightness" type="i"><range min="10" max="200"/><default>100</default><summary>Screen flash brightness relative to the default, in percent</summary></key>
    <key name="flash-thickness" type="i"><range min="1" max="40"/><default>5</default><summary>Screen flash border thickness in pixels</summary></key>
    <key name="flash-count" type="i">
      <range min="0" max="5"/>
      <default>1</default>
      <summary>Number of screen-edge pulses per notification</summary>
      <description>Zero disables the effect. Pulse spacing is controlled by the flash interval setting.</description>
    </key>
    <key name="popup-top-margin" type="i"><range min="0" max="100"/><default>6</default><summary>Popup top margin</summary></key>
    <key name="popup-left-margin" type="i"><range min="0" max="100"/><default>9</default><summary>Popup offset to the left</summary></key>
    <key name="main-panel-gap" type="i"><range min="0" max="100"/><default>12</default><summary>Gap between main page and nearest panel</summary></key>
    <key name="panel-gap" type="i"><range min="0" max="100"/><default>12</default><summary>Gap between side panels</summary></key>
    <key name="section-order" type="as">
      <default>['profile', 'overview', 'slots', 'evaluations', 'agenda', 'notifications', 'chat', 'services']</default>
      <summary>Main page section order</summary>
    </key>
    <key name="show-profile" type="b"><default>true</default><summary>Show profile on the main page</summary></key>
    <key name="show-projects" type="b"><default>true</default><summary>Show projects on the main page</summary></key>
    <key name="show-logtime" type="b"><default>true</default><summary>Show logtime on the main page</summary></key>
    <key name="show-evaluations" type="b"><default>true</default><summary>Show evaluations on the main page</summary></key>
    <key name="show-agenda" type="b"><default>true</default><summary>Show agenda on the main page</summary></key>
    <key name="show-notifications" type="b"><default>true</default><summary>Show notifications on the main page</summary></key>
    <key name="blocked-chat-seats" type="as"><default>[]</default><summary>Blocked cluster chat seats</summary></key>
    <key name="show-chat" type="b"><default>true</default><summary>Show Cluster Chat button and panel</summary></key>
    <key name="show-slots" type="b"><default>true</default><summary>Show Evaluation Slots</summary></key>
    <key name="service-enabled" type="b"><default>true</default><summary>Enable 42 Services</summary></key>
    <key name="show-services" type="b"><default>true</default><summary>Show 42 Services button and panel</summary></key>
    <key name="service-sites" type="s"><default>''</default><summary>Custom website catalogue (empty uses built-in defaults)</summary></key>
    <key name="project-default-tab" type="s">
      <choices><choice value="todo"/><choice value="note"/></choices><default>'todo'</default>
      <summary>First tab when opening project notes</summary>
    </key>
    <key name="project-open-direct" type="b"><default>false</default><summary>Open project website instead of notes panel</summary></key>
  <key name="notify-evaluations" type="b"><default>true</default><summary>Evaluation system notifications</summary></key>
    <key name="notify-agenda" type="b"><default>true</default><summary>Agenda system notifications</summary></key>
    <key name="notify-chat" type="b"><default>true</default><summary>Chat system notifications</summary></key>
    <key name="warn-open-slots-on-logout" type="b"><default>true</default><summary>Warn about open slots, scheduled evaluations and pending feedback before logout</summary></key>
  </schema>
</schemalist>
